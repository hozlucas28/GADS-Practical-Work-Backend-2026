# Configuración de entorno para GADS Backend.
# Copiar este archivo a `.env` y ajustar los valores. Todas las variables
# usan el prefijo `GADS_` (ver app/config.py).

# --- Base de datos ---
# URL SQLAlchemy. Por defecto: SQLite local (apto para dev y tests).
GADS_DATABASE_URL=sqlite:///./app.db

# --- JWT ---
# Obligatorio overridear en producción. El default solo aplica en dev/tests.
GADS_JWT_SECRET=cambiar-en-produccion
GADS_JWT_ALGORITHM=HS256
GADS_JWT_EXPIRE_MINUTES=60

# --- Bootstrap del primer admin (opcional) ---
# Si las cinco variables están seteadas y la BD no tiene admin, el lifespan
# crea Empresa + Empleado + Usuario admin automáticamente al arrancar.
# Alternativa manual: POST /auth/register-first-admin.
#GADS_INITIAL_ADMIN_USER=admin
#GADS_INITIAL_ADMIN_PASSWORD=admin
#GADS_INITIAL_ADMIN_EMAIL=admin@local.dev
#GADS_INITIAL_EMPRESA_RAZON_SOCIAL=Nero IT
#GADS_INITIAL_EMPRESA_CUIT=30-71888999-1

# --- Datos demo (solo desarrollo/preview) ---
# En producción debe quedar en false para no crear usuarios/empleados de ejemplo.
GADS_SEED_DEMO_DATA=false

# --- CORS ---
# Separar varios dominios con coma.
# Para producción en Render, agregar el dominio del frontend desplegado.
# Ejemplo: GADS_CORS_ORIGINS=https://mi-frontend.onrender.com,http://localhost:3000
# Para permitir cualquier origen (solo desarrollo): GADS_CORS_ORIGINS=*
GADS_CORS_ORIGINS=https://gads-practical-work-frontend-2026-njeq.onrender.com,http://localhost:3000,http://localhost:3001

# --- Zona horaria por defecto para parseo de CSV de fichadas ---
#GADS_DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires
